# =============================================================================
#  Copie para `.env` e preencha. NUNCA versione o `.env` (já está no .gitignore).
#
#  Só as 4 primeiras seções são obrigatórias. O resto tem padrão razoável e você
#  provavelmente não precisa mexer no começo.
# =============================================================================

# --- 1. BANCO (obrigatório) --------------------------------------------------
# Crie um projeto novo em supabase.com. Precisa da extensão pgvector ativada
# (Database > Extensions > "vector") e das migrations de src/db/migrations/
# rodadas na ordem, pelo SQL Editor.
# A service_role key está em Project Settings > API. Ela ignora RLS: é chave de
# servidor, nunca coloque no front.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- 2. IA (obrigatório) -----------------------------------------------------
# platform.openai.com > API keys. Usada para o chat e para os embeddings do RAG.
# ATENÇÃO: se o saldo zerar, a IA para de responder e o /health continua verde.
# Deixe billing automático ligado ou monitore o saldo.
OPENAI_API_KEY=

# --- 3. AGENDA (obrigatório para agendar) ------------------------------------
# Service Account no Google Cloud (não OAuth):
#   1. console.cloud.google.com > novo projeto > ativar "Google Calendar API"
#   2. Credenciais > Criar > Conta de serviço > Chaves > JSON
#   3. No Google Calendar da empresa: Configurações da agenda > Compartilhar com
#      pessoas > adicione o e-mail da service account com "Fazer alterações"
#   4. GOOGLE_CALENDAR_ID é o "ID da agenda" na mesma tela (o e-mail da conta,
#      se for a agenda principal)
# A chave privada vai numa linha só, com \n literais, entre aspas.
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=

# --- 4. WHATSAPP (obrigatório para atender) ----------------------------------
# Evolution API (self-hosted). Crie uma instância e aponte o webhook dela para
#   https://SEU-DOMINIO/webhook/whatsapp   evento: MESSAGES_UPSERT
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# TRAVA DE TESTE — comece com ela ligada.
# Enquanto tiver número aqui, a IA só responde a esses; qualquer outro é
# ignorado em silêncio. Vazio = atende todo mundo (produção).
# Ligue para o público SÓ depois de testar conversa completa.
ALLOWED_NUMBERS=5511999999999

# --- 5. PAINEL ---------------------------------------------------------------
# Senha do dashboard em /admin. Invente uma longa. Compartilhe com o cliente.
ADMIN_TOKEN=

# --- 6. HANDOFF --------------------------------------------------------------
# WhatsApp de quem assume as conversas escaladas (só dígitos, com DDI).
# Sem isso o handoff ainda trava a IA e registra, mas ninguém é avisado.
SECRETARIA_WHATSAPP=5511999999999
# Depois de quantas horas uma conversa escalada volta pra IA.
HANDOFF_EXPIRA_HORAS=24

# --- 7. AGENDA: MODELO DE VAGAS ----------------------------------------------
# true  = a IA só oferece horários que o time PUBLICOU como evento na agenda.
#         Sem evento publicado, ela não agenda ninguém. É o padrão, e é o certo
#         quando a agenda vive cheia: o time marca as poucas folgas em vez de
#         manter todos os compromissos lançados.
# false = modelo antigo: todo o expediente menos o que estiver ocupado. Só use
#         se a agenda estiver sempre 100% atualizada — senão a IA acha o dia
#         inteiro livre e marca em cima de gente.
SLOTS_EXPLICITOS=true
# O que o time escreve no título do evento pra marcar uma vaga (sem acento, sem
# caixa, comparação por "contém"). Combine UMA palavra e não mude.
# Evite "livre"/"vago": casa com evento pessoal do time ("sala livre") e a IA
# passa a oferecer cadeira que não existe.
SLOTS_PALAVRAS=disponivel
# Duração esperada de uma vaga. Padrão: SERVICO.duracaoMin de negocio.ts.
# SLOTS_DURACAO_MIN=60

# --- 8. FOLLOW-UP (quem parou de responder) ----------------------------------
FOLLOWUP_ATIVO=true
FOLLOWUP_APOS_MS=7200000        # 2h de silêncio
FOLLOWUP_MAXIMO=1               # 1 tentativa. Mais que isso vira perseguição.
FOLLOWUP_HORA_INICIO=9
FOLLOWUP_HORA_FIM=19
FOLLOWUP_INTERVALO_MS=600000

# --- 9. LEMBRETE DE VÉSPERA --------------------------------------------------
LEMBRETE_ATIVO=true
LEMBRETE_HORA=18

# --- 10. REVISÃO DIÁRIA (relatório no Discord) -------------------------------
REVISAO_ATIVA=true
REVISAO_HORA=20
# Webhook de um canal do Discord. Vazio = a revisão roda mas não publica.
DISCORD_WEBHOOK=

# --- 11. GUARDA-CORPO --------------------------------------------------------
# Escala sozinho quando a IA trava no fechamento ou repete resposta.
# Os padrões são calibrados: mexer pra baixo derruba atendimento saudável.
GUARDRAILS_ATIVO=true

# --- 12. HUMANIZAÇÃO DA RESPOSTA ---------------------------------------------
# Digita, pausa entre balões, agrupa mensagens picotadas. Padrões estão bons.
AGRUPAMENTO_MS=8000

# --- 13. CRM (opcional) ------------------------------------------------------
# Webhook "Entrada de Negócios" do DataCrazy. Só o lead que FECHA agendamento
# vira negócio. Vazio = integração desligada, sem erro.
DATACRAZY_WEBHOOK_URL=

# --- 14. SERVIDOR ------------------------------------------------------------
PORT=3000
